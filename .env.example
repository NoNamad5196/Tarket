# Register these in Vercel Project Settings > Environment Variables.
# Leave GEMINI_API_KEY empty for the clearly labelled demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Stable random secret of at least 32 characters; do not rotate within a day.
TICKET_HMAC_SECRET=
